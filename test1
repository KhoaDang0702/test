                    <th>Thứ tự</th>
                    <th>Mã sản phẩm</th>
                    <th>Tên sản phẩm</th>
                    <th>Xuất xứ</th>
                    <th>Đơn giá</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="order-num primary-color">1</td>
                    <td>#614232</td>
                    <td>Sữa tươi skibidi biệt t...</td>
                    <td class="origin"><ion-icon name="flag"></ion-icon> Việt Nam</td>
                    <td class="status-cell"><span class="status-badge stock">Còn hàng</span></td>
                    <td>245.000đ</td>
                </tr>
                </tbody>
        </table>
        <button class="view-more-button">Xem đầy đủ</button>
    </div>

</div>

/* --- CSS cho Container Content --- */

.container__content {
    padding: 24px;
    background-color: #f7f7f7; /* Màu nền nhẹ cho nội dung */
    height: calc(100% - 60px); /* Trừ chiều cao header */
    overflow-y: auto;
}

/* Các thẻ tổng quan (Summary Cards) */
.overview-section {
    margin-bottom: 24px;
}

.overview-section h2 {
    font-size: 20px;
    margin-bottom: 16px;
    color: #444;
}

.summary-cards {
    display: flex;
    gap: 20px;
}

.card {
    background: #fff;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    flex-grow: 1;
}

.summary-cards .card {
    width: calc(33.333% - 14px); /* Chia 3 cột */
}

.card .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    color: #888;
    margin-bottom: 15px;
}

.data-point .data-title {
    font-size: 14px;
    color: #666;
    margin-bottom: 5px;
}

.data-point .value {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 5px;
}

.data-point .primary-value { color: #F654a9; } /* Hồng */
.data-point .secondary-value { color: #868686; } /* Xám */
.data-point .tertiary-value { color: #32c45e; } /* Xanh lá */

.data-point .change {
    font-size: 12px;
}

.data-point .change.up { color: #32c45e; }
.data-point .change.down { color: #ff5050; }
.data-point .change span {
    color: #888;
    margin-left: 5px;
}


/* Biểu đồ */
.chart-section {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
}

.product-chart-card {
    width: 35%;
}

.revenue-chart-card {
    width: 65%;
}

/* Bảng Dữ liệu */
.data-table-section {
    padding: 0;
}

.data-table-section .header {
    padding: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #eee;
}

.data-table-section .header p {
    font-size: 16px;
    font-weight: 600;
    margin-right: auto;
}

.data-table-section .filter-button {
    background: #f0f0f0;
    border: none;
    padding: 8px 15px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    color: #555;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
}

table thead {
    background-color: #fcfcfc;
    color: #666;
    text-align: left;
}

table th {
    padding: 15px 18px;
    font-weight: 500;
    border-bottom: 1px solid #eee;
}

table td {
    padding: 12px 18px;
    border-bottom: 1px solid #f5f5f5;
}

table tbody tr:hover {
    background-color: #f9f9f9;
}

.order-num {
    font-weight: bold;
    color: #F654a9;
}

.origin {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #555;
}

.status-badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
}

.status-badge.stock {
    background-color: #e6ffe6;
    color: #32c45e;
}

.status-badge.out-of-stock {
    background-color: #ffe6e6;
    color: #ff5050;
}

.view-more-button {
    width: 100%;
    padding: 15px;
    background: none;
    border: none;
    border-top: 1px solid #eee;
    color: #F654a9;
    font-weight: 600;
    cursor: pointer;
    border-radius: 0 0 12px 12px;
}

/* Để icon menu header có thể nhấn được */
.container__header .header__left .icon {
    cursor: pointer;
}



